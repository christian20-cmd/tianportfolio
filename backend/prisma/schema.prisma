generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // remplace par "mysql" si tu pars sur MySQL
  url      = env("DATABASE_URL")
}

enum ProjectType {
  mobile
  desktop
  web
}

enum ProjectStatus {
  local
  deployed
}

model Project {
  id            Int          @id @default(autoincrement())
  slug          String       @unique
  title         String
  tagline       String?
  categorie     String?
  description   String?
  role          String?
  client        String?
  type          ProjectType
  status        ProjectStatus @default(local)
  year          Int?
  image         String?
  link          String?
  downloadLink  String?      @map("download_link")
  inProgress    Boolean      @default(false) @map("in_progress")
  displayOrder  Int          @default(0) @map("display_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  screenshots   Screenshot[]
  tools         ProjectTool[]

  @@map("projects")
}

model Tool {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  iconName  String   @map("icon_name")
  color     String

  projects  ProjectTool[]

  @@map("tools")
}

model ProjectTool {
  projectId     Int   @map("project_id")
  toolId        Int   @map("tool_id")
  displayOrder  Int   @default(0) @map("display_order")

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tool          Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([projectId, toolId])
  @@map("project_tools")
}

model Screenshot {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  src           String
  titre         String?
  caption       String?
  displayOrder  Int      @default(0) @map("display_order")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features      ScreenshotFeature[]

  @@map("screenshots")
}

model ScreenshotFeature {
  id            Int      @id @default(autoincrement())
  screenshotId  Int      @map("screenshot_id")
  texte         String
  displayOrder  Int      @default(0) @map("display_order")

  screenshot    Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)

  @@map("screenshot_features")
}